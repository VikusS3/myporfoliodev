---
import Layout from "@/layouts/Layout.astro";

import Hero from "@/components/Hero.astro";

import Experience from "@/components/Experience.astro";
import Projects from "@/components/Projects.astro";
import Certificates from "@/components/Certificates.astro";
import ContactCTA from "@/components/ContactCTA.astro";
import Footer from "@/components/Footer.astro";
import { DEFAUL_TITLE_PAGE, DEFAUL_DESCRIPTION_PAGE } from "@/utils/config";
import presentation from "@/data/presentacion";
import { SITE_URL } from "@/data/config";

const projectList = presentation.projects.map((project, index) => ({
  "@type": "ListItem",
  position: index + 1,
  item: {
    "@type": "WebApplication",
    name: project.name,
    description: project.description,
    url: project.ref,
    image: project.image ? `${SITE_URL}${project.image}` : undefined,
    operatingSystem: "Web",
    applicationCategory: "BusinessApplication",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
    },
  },
}));
---

<Layout title={DEFAUL_TITLE_PAGE} description={DEFAUL_DESCRIPTION_PAGE}>
  <main class="flex flex-col gap-16">
    <Hero />
    <Experience />
    <Certificates />
    <Projects />
    <ContactCTA />
    <Footer />
  </main>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "@id": `${SITE_URL}/#profilepage`,
        "mainEntity": { "@id": `${SITE_URL}/#person` },
        "about": { "@id": `${SITE_URL}/#person` },
      },
      null,
      2
    )}
  ></script>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Proyectos de Saul Orellana",
        "description":
          "Portafolio de proyectos web desarrollados por Saul Orellana, desarrollador fullstack en Lima, Perú.",
        "url": SITE_URL,
        "itemListElement": projectList,
      },
      null,
      2
    )}
  ></script>
</Layout>
