---
import { getCollection } from "astro:content";
import type { Post } from "@/types/post";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post: { slug: any }) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as {
  post: { data: Post; slug: string; render: () => any };
};

const { Content } = await post.render();
const slug = post.slug;
const title = post.data.title;
const description = post.data.description || "";
const date = post.data.date;
---

<Layout
  title={`${title} | Blog de SaulDev`}
  description={description}
  canonical={`/posts/${slug}`}
>
  <article class="flex flex-col gap-6 animate-fade-in">
    <header class="flex flex-col gap-2 pb-4 border-b border-white/[0.04]">
      <a
        href="/posts"
        class="inline-flex items-center gap-1.5 text-xs text-neutral-500 hover:text-accent transition-colors duration-300 w-fit"
        aria-label="Volver al listado de artículos del blog"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Volver al blog
      </a>
      <h1 class="text-2xl sm:text-3xl font-bold text-neutral-50 leading-tight text-balance">
        {title}
      </h1>
      <p class="text-xs text-neutral-500">
        <time datetime={date}>{date}</time>
      </p>
    </header>

    <div class="markdown max-w-none">
      <Content />
    </div>
  </article>

  <script is:inline type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "image": "https://sauldev.pages.dev/og-image.jpg",
      "author": {
        "@type": "Person",
        "name": "Saul Orellana",
        "url": "https://sauldev.pages.dev"
      },
      "publisher": {
        "@type": "Organization",
        "name": "SaulDev",
        "logo": {
          "@type": "ImageObject",
          "url": "https://sauldev.pages.dev/favicon.svg"
        }
      },
      "datePublished": date,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://sauldev.pages.dev/posts/${slug}`
      }
    }, null, 2)}
  </script>

  <script is:inline type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://sauldev.pages.dev"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://sauldev.pages.dev/posts"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": `https://sauldev.pages.dev/posts/${slug}`
        }
      ]
    }, null, 2)}
  </script>
</Layout>
