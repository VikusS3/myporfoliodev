---
type Props = {
  name: string;
  description: string;
  technologies: string[];
  ref: string;
  image?: string;
};

const { name, description, technologies, ref, image } = Astro.props;

const initials = name
  .replace(/[^a-zA-Z\s0-9]/g, "")
  .split(" ")
  .map((w) => w[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const gradients = [
  "from-red-900/40 to-rose-900/40",
  "from-blue-900/40 to-indigo-900/40",
  "from-emerald-900/40 to-teal-900/40",
  "from-amber-900/40 to-orange-900/40",
  "from-purple-900/40 to-pink-900/40",
];

const hash = name.split("").reduce((acc, c) => acc + c.charCodeAt(0), 0);
const gradientClass = gradients[hash % gradients.length];

const techColors: Record<string, string> = {
  React: "from-sky-500/10 to-blue-500/10 border-sky-500/20 text-sky-300",
  "React-Native": "from-sky-500/10 to-blue-500/10 border-sky-500/20 text-sky-300",
  Astro: "from-orange-500/10 to-red-500/10 border-orange-500/20 text-orange-300",
  Tailwind: "from-cyan-500/10 to-teal-500/10 border-cyan-500/20 text-cyan-300",
  TailwindCss: "from-cyan-500/10 to-teal-500/10 border-cyan-500/20 text-cyan-300",
  TypeScript: "from-blue-500/10 to-indigo-500/10 border-blue-500/20 text-blue-300",
  Php: "from-indigo-500/10 to-purple-500/10 border-indigo-500/20 text-indigo-300",
  MySql: "from-orange-500/10 to-yellow-500/10 border-orange-500/20 text-orange-300",
  Supabase: "from-emerald-500/10 to-green-500/10 border-emerald-500/20 text-emerald-300",
  Expo: "from-violet-500/10 to-purple-500/10 border-violet-500/20 text-violet-300",
  Flight: "from-stone-500/10 to-neutral-500/10 border-stone-500/20 text-stone-300",
};
---

<a
  href={ref}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative flex flex-col rounded-xl border border-white/[0.06] bg-white/[0.02]
    transition-all duration-400 overflow-hidden cursor-pointer
    hover:border-accent/20 hover:bg-accent/[0.02]
    hover:shadow-[0_0_40px_-16px_rgba(248,113,113,0.12)]
    hover:-translate-y-0.5
    focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
>
  {
    image ? (
      <div class="relative aspect-video overflow-hidden">
        <img
          src={image}
          alt={name}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
      </div>
    ) : (
      <div
        class={`relative flex aspect-video items-center justify-center bg-gradient-to-br ${gradientClass}`}
      >
        <span class="text-3xl sm:text-4xl font-bold text-white/20 select-none">
          {initials}
        </span>
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
      </div>
    )
  }

  <div class="flex flex-col gap-3 p-4 sm:p-5">
    <h3 class="text-base font-semibold text-neutral-50 group-hover:text-accent transition-colors duration-300">
      {name}
    </h3>

    <p class="text-sm text-neutral-400 leading-relaxed line-clamp-3">
      {description}
    </p>

    <div class="flex flex-wrap gap-1.5 mt-auto pt-1">
      {
        technologies.map((tech) => (
          <span
            class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-medium
              transition-all duration-300
              ${techColors[tech] || "border-neutral-800 text-neutral-500 bg-neutral-900/50"}
              group-hover:border-opacity-40`}
          >
            {tech}
          </span>
        ))
      }
    </div>
  </div>

  <div class="absolute top-3 right-3 z-10 opacity-0 translate-y-1 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-500">
      <path d="M7 7h10v10"/><path d="M7 17 21 3"/>
    </svg>
  </div>
</a>
