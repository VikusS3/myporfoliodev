---
type Props = {
  name: string;
  duration: string;
  role: string;
  description: string;
};

const { name, duration, description, role } = Astro.props;
---

<article
  class="group relative flex w-full flex-col gap-3 rounded-xl border border-white/[0.06] bg-white/[0.02] p-4 sm:p-5
    transition-all duration-400 overflow-hidden
    hover:border-accent/20 hover:bg-accent/[0.02]
    hover:shadow-[0_0_30px_-12px_rgba(248,113,113,0.12)]
    focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
>
  <header
    class="flex flex-col gap-1.5 sm:flex-row sm:items-start sm:justify-between relative z-10"
  >
    <div class="flex flex-col gap-0.5">
      <p class="text-base font-semibold text-neutral-50 group-hover:text-accent transition-colors duration-300">{name}</p>
      <span class="text-xs text-accent/80 font-medium">{role}</span>
    </div>
    <span class="text-xs text-neutral-500 whitespace-nowrap">{duration}</span>
  </header>

  <main class="relative z-10">
    <p class="text-sm text-neutral-400 leading-relaxed">{description}</p>
  </main>

  <div
    class="pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-500
      group-hover:opacity-100"
    style="box-shadow: inset 0 0 0 1px rgba(248,113,113,0.08);"
  >
  </div>
</article>
