---
import presentation from "@/data/presentacion";
---

<section class="flex flex-col gap-6 animate-slide-up">
  <div class="flex items-center gap-3">
    <h2 class="text-2xl font-bold text-neutral-50">Formaci&oacute;n</h2>
    <span class="h-px flex-1 bg-gradient-to-r from-white/[0.06] to-transparent"></span>
  </div>

  {
    presentation.education.map((edu) => (
      <article
        class="group relative flex w-full flex-col gap-5 overflow-hidden rounded-xl border border-white/[0.06] bg-white/[0.02] p-4 sm:p-6 sm:flex-row
          transition-all duration-400
          hover:border-accent/20 hover:bg-accent/[0.02]
          hover:shadow-[0_0_40px_-16px_rgba(248,113,113,0.12)]
          focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
      >
        {
          edu.image && (
            <div class="relative shrink-0 overflow-hidden rounded-lg border border-white/[0.06] sm:w-48 sm:self-start">
              <img
                src={edu.image}
                alt={`${edu.title} - ${edu.institution}`}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
          )
        }
        <div class="flex flex-col gap-3">
          <div class="flex flex-col gap-0.5">
            <h3 class="text-lg font-semibold text-neutral-50 group-hover:text-accent transition-colors duration-300">
              {edu.title}
            </h3>
            <span class="text-sm font-medium text-accent/80">{edu.profession}</span>
          </div>
          <p class="flex items-center gap-1.5 text-xs text-neutral-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
            {edu.institution} &middot; {edu.year}
          </p>
          {
            edu.description && (
              <p class="text-sm leading-relaxed text-neutral-400">{edu.description}</p>
            )
          }
        </div>
      </article>
    ))
  }

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      presentation.certificates.map((cert, index) => (
        <a
          href={cert.url || cert.image || "#"}
          target={cert.url ? "_blank" : undefined}
          rel={cert.url ? "noopener noreferrer" : undefined}
          class="group relative flex flex-col rounded-xl border border-white/[0.06] bg-white/[0.02] p-4 sm:p-5
            transition-all duration-400 overflow-hidden cursor-pointer
            hover:border-accent/20 hover:bg-accent/[0.02]
            hover:shadow-[0_0_30px_-12px_rgba(248,113,113,0.12)]
            hover:-translate-y-0.5
            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
        >
          <div class="flex flex-col gap-3">
            {
              cert.image && (
                <div class="relative aspect-video overflow-hidden rounded-lg border border-white/[0.06]">
                  <img
                    src={cert.image}
                    alt={cert.name}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )
            }
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-semibold leading-snug text-neutral-50 group-hover:text-accent transition-colors duration-300">
                {cert.name}
              </h3>
              <span class="text-xs text-neutral-500">{cert.organization} &middot; {cert.year}</span>
            </div>
          </div>
          <div class="absolute top-3 right-3 z-10 opacity-0 translate-y-1 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-500">
              <path d="M7 7h10v10"/><path d="M7 17 21 3"/>
            </svg>
          </div>
        </a>
      ))
    }
  </div>
</section>
