---
import presentation from "@/data/presentacion";

function removeTrailingSlash(pathname: string) {
  const matchTrailingSlash = /\w+\/$/;
  if (matchTrailingSlash.test(pathname)) return pathname.slice(0, -1);
  return pathname;
}

const pathname = removeTrailingSlash(Astro.url.pathname);
const initials = presentation.title
  .replace(/[^a-zA-Z\s]/g, "")
  .split(" ")
  .map((w) => w[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<header
  class="relative z-40 flex w-full flex-col gap-4 sm:flex-row sm:items-center sm:justify-between pb-4 md:pb-6
  border-b border-white/[0.04]"
>
  <a
    href="/"
    class="inline-flex items-center gap-2.5 text-neutral-50 hover:text-accent transition-colors duration-300"
    aria-label="Saul Orellana - Ir al inicio"
  >
    <span
      class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent/10 text-xs font-bold text-accent border border-accent/20"
    >
      {initials}
    </span>
    <span class="text-sm font-medium">Saul Orellana</span>
  </a>

  <nav role="navigation" aria-label="Navegación principal">
    <ul role="list" class="flex flex-row items-center gap-5">
      <li>
        <a
          href="/"
          class="relative text-sm font-medium transition-colors duration-300
            after:absolute after:-bottom-1 after:left-0 after:h-px after:w-full after:origin-right after:scale-x-0
            after:bg-accent after:transition-transform after:duration-300
            hover:after:origin-left hover:after:scale-x-100
            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-2 focus-visible:ring-offset-black
            class:list={{
              ["text-neutral-50 after:scale-x-100 after:origin-left"]: pathname === "/",
              ["text-neutral-400 hover:text-neutral-200"]: pathname !== "/",
            }}"
          aria-current={pathname === "/" ? "page" : undefined}
        >
          Inicio
        </a>
      </li>
      <span class="text-neutral-700 select-none" aria-hidden="true">·</span>
      <li>
        <a
          href="/posts"
          class="relative text-sm font-medium transition-colors duration-300
            after:absolute after:-bottom-1 after:left-0 after:h-px after:w-full after:origin-right after:scale-x-0
            after:bg-accent after:transition-transform after:duration-300
            hover:after:origin-left hover:after:scale-x-100
            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-2 focus-visible:ring-offset-black
            class:list={{
              ["text-neutral-50 after:scale-x-100 after:origin-left"]: pathname === "/posts",
              ["text-neutral-400 hover:text-neutral-200"]: pathname !== "/posts",
            }}"
          aria-current={pathname === "/posts" ? "page" : undefined}
        >
          Blog
        </a>
      </li>
    </ul>
  </nav>
</header>
